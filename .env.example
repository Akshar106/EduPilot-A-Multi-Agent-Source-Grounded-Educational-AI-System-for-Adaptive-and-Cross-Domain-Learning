# EduPilot — environment configuration
# Copy to .env and fill in. Never commit the real .env.

# ─── LLM providers ───────────────────────────────────────────────────────────
# At least one is required. The default model is Groq, so GROQ_API_KEY is what
# you need unless you change DEFAULT_MODEL in src/edupilot/core/config.py.
GROQ_API_KEY=gsk_your_key_here
GEMINI_API_KEY=your_key_here

# ─── Vector store ────────────────────────────────────────────────────────────
PINECONE_API_KEY=pcsk_your_key_here

# Pinecone index name (will be created automatically on first run)
PINECONE_INDEX_NAME=edupilot

# GCP is used here — compatible with Streamlit Cloud deployment
# and Pinecone's free-tier starter region
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Base name for versioned indexes. Concrete indexes are edupilot-v1, -v2, ...
# and data/state/index_pointer.json records which one serves traffic.
PINECONE_INDEX_BASE=edupilot

# dotproduct is required for native sparse-dense hybrid search. Embeddings are
# L2-normalized, so dot product equals cosine — dense ranking is unchanged.
PINECONE_METRIC=dotproduct

# ─── Security (REQUIRED) ─────────────────────────────────────────────────────
# JWT signing key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters. In production the app refuses to start
# without it rather than falling back to a predictable default — anyone who
# can guess the key can mint an admin token.
JWT_SECRET_KEY=

# Browser origins allowed to call the API, comma-separated. Defaults to
# localhost only. Do not use "*": it lets any website call this API with the
# user's credentials attached.
CORS_ALLOWED_ORIGINS=http://localhost:8000

# Set true ONLY when running behind a reverse proxy you control. It makes the
# app trust X-Forwarded-For, which is client-controlled — trusting it without
# a proxy lets a caller forge a new identity per request and bypass rate limits.
TRUST_PROXY_HEADERS=false

# "production" enables secure cookies, disables /docs, and makes
# JWT_SECRET_KEY mandatory.
EDUPILOT_ENV=development

# Single-user mode. When false there is no sign-in: every request resolves to
# one fixed local identity with admin rights, which is what lets the bundled
# frontend work without a login screen.
#
# Defaults to false in development and true in production. Setting it false
# while EDUPILOT_ENV=production is refused at startup — an open knowledge base
# means any visitor can inject documents that every answer is then grounded in.
EDUPILOT_AUTH_REQUIRED=false

# First admin account, created on startup when no users exist. Without it the
# admin-only knowledge-base routes are unreachable on a fresh deployment.
BOOTSTRAP_ADMIN_EMAIL=you@university.edu
BOOTSTRAP_ADMIN_PASSWORD=

# Longest accepted question. Unbounded input is unbounded prompt cost.
MAX_QUERY_CHARS=4000

# ─── Models ──────────────────────────────────────────────────────────────────
# 384-dim (matches the existing index dimension) with a 512-token window.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# ─── Query transformation ────────────────────────────────────────────────────
# Acronym expansion always runs (deterministic, free). These two each add an
# LLM round-trip per query, so they are off by default.
ENABLE_MULTI_QUERY=false
ENABLE_HYDE=false

# ─── Storage ─────────────────────────────────────────────────────────────────
# Root for everything the app reads or writes: the course corpus, student
# uploads, the database, and local caches. Defaults to <repo>/data. Set this
# to a mounted volume in a container — it is the only path that must be
# writable, and the only one worth persisting between deploys.
# EDUPILOT_DATA_DIR=/var/lib/edupilot

# Both default to sensible paths under EDUPILOT_DATA_DIR; override only if you
# need them somewhere else.
# SQLITE_DB_PATH=data/edupilot.db
# Caches and index metadata. Safe to delete; rebuilt on demand.
# EDUPILOT_STATE_DIR=data/state

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# "json" for log aggregators, "human" for a terminal.
LOG_FORMAT=human
