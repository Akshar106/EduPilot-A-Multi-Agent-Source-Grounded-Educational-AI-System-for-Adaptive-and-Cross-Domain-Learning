# ── Secrets ──────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Runtime data ─────────────────────────────────────────────────────────────
# Everything the app reads or writes at runtime: the course corpus, student
# uploads, the SQLite database, and local caches. Nothing here is source, and
# nothing here belongs in the repo.
data/

*.db
*.db-shm
*.db-wal

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── Editors and OS ───────────────────────────────────────────────────────────
.claude/
.DS_Store
.idea/
.vscode/

# Deploy seed state: derived artifacts the container needs to serve.
# bm25.json is the fitted IDF table; index_pointer.json names the live index.
# Small, and without them a fresh deploy has no index and no lexical search.
!deploy/seed/
!deploy/seed/*.json
